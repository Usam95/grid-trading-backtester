            "$ref": "#/components/schemas/SizingSpec"
          },
          "slippage": {
            "$ref": "#/components/schemas/SlippageSpec"
          },
          "symbol": {
            "default": "BTCUSDT",
            "title": "Symbol",
            "type": "string"
          },
          "venue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue"
          }
        },
        "title": "BacktestRequest",
        "type": "object"
