      "BacktestOptions": {
        "properties": {
          "include_trades": {
            "default": true,
            "title": "Include Trades",
            "type": "boolean"
          },
          "with_report": {
            "default": false,
            "title": "With Report",
            "type": "boolean"
          }
        },
        "title": "BacktestOptions",
        "type": "object"
      },
      "BacktestRequest": {
        "description": "A full declarative backtest spec accepted by the API.",
        "properties": {
          "bootstrap": {
            "$ref": "#/components/schemas/BootstrapSpec"
          },
          "constraints": {
            "$ref": "#/components/schemas/ConstraintsSpec"
          },
          "data": {
            "$ref": "#/components/schemas/DataSpec"
          },
          "exchange_rules": {
            "$ref": "#/components/schemas/ExchangeRulesSpec"
          },
          "fees": {
            "$ref": "#/components/schemas/FeesSpec"
          },
          "fill": {
            "$ref": "#/components/schemas/FillSpec"
          },
          "filter": {
            "$ref": "#/components/schemas/FilterSpec"
          },
          "grid": {
            "$ref": "#/components/schemas/GridSpec"
          },
          "initial_cash": {
            "default": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Initial Cash",
            "type": "number"
          },
          "margin": {
            "$ref": "#/components/schemas/MarginSpec"
          },
